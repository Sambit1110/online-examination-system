# Copy this file to .env and fill in real values before running the server.

# Required. Secret used to sign/verify JWT session tokens.
# Generate one locally, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. Backend port (default 5050). Uncomment and change if 5050 is also
# occupied on your machine — remember to update vite.config.ts's proxy target
# to match.
# PORT=5050
