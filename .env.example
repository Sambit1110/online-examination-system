# Copy this file to .env and fill in real values before running the app.
# Never commit .env — it is already listed in .gitignore.

# ==========================================================
# SUPABASE (the app's primary/production data & auth layer)
# ==========================================================
# Both come from your Supabase project's Settings -> API page
# (the newer "publishable" / "secret" key naming).
# The publishable key is safe to expose to the browser by design (see
# src/lib/supabaseClient.ts) — real authorization is enforced by the
# Row Level Security policies in supabase/migrations/.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials — used by api/admin-users.js (a Vercel serverless
# function) and scripts/supabase-seed.mjs. NEVER prefix these with VITE_,
# which would bundle them into client-side code, and never commit them.
# The secret key bypasses Row Level Security entirely (it is the direct
# replacement for what Supabase used to call the "service_role" key).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional — only needed if you ask the CLI (via psql/`supabase db push`) to
# apply migrations directly. This is your project's Postgres database
# password (set at project creation / resettable from the dashboard), a
# DIFFERENT credential from the publishable/secret keys above.
# SUPABASE_DB_PASSWORD=

# Optional — an alternative way to apply migrations when your network can't
# reach Postgres directly (only HTTPS egress, no raw TCP — common in
# sandboxed/CI environments). A Personal Access Token from your Supabase
# account (https://supabase.com/dashboard/account/tokens), used to call the
# Management API over HTTPS instead of connecting to the database directly.
# Distinct from every other credential on this page — it's account-level,
# not project-level, so treat it with the same care as a root credential.
# SUPABASE_ACCESS_TOKEN=

# ==========================================================
# LEGACY LOCAL MODE (optional — SQLite + Express, no Supabase account
# needed; see README.md "Legacy local mode" for when you'd use this)
# ==========================================================

# Secret used to sign/verify JWT session tokens in the legacy backend.
# Generate one locally, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. Legacy backend port (default 5050). Uncomment and change if
# 5050 is also occupied on your machine — remember to update
# vite.config.ts's proxy target to match.
# PORT=5050
